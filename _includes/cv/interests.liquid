{% comment %}
  Unified interests entry renderer for both formats
  - RenderCV OneLineEntry: label, details
  - JSONResume: name, keywords, icon
{% endcomment %}

<div class="card-text font-weight-light">
  {% for entry in entries %}
    <div class="interest-item">
      {% if entry.icon %}
        <i class="{{ entry.icon }}"></i>
      {% endif %}
      {% capture interest_name %}
        {% if entry.label %}{{ entry.label }}{% elsif entry.name %}{{ entry.name }}{% endif %}
      {% endcapture %}
      <strong>{{ interest_name | strip }}:</strong>
      {% if entry.details %}
        {{ entry.details }}
      {% elsif entry.keywords %}
        {% for keyword in entry.keywords %}
          {% if forloop.last %}
            {{ keyword }}
          {% else %}
            {{ keyword }},
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  {% endfor %}
</div>

<style>
  .interest-item {
    padding: 0.5rem 0;
  }
</style>
